# =========================================================
# Khaled Portfolio — Express Contact Backend
# =========================================================

NODE_ENV=development
PORT=3000

# Use 0 locally. Use 1 when deployed behind Render/Railway/Nginx/reverse proxy.
TRUST_PROXY=0

# Comma-separated origins allowed to call the API.
SITE_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# =========================================================
# Mail mode
# =========================================================
# console = runs without SMTP and writes messages to storage/contact-messages.log
# smtp    = sends real email using Nodemailer SMTP settings below
MAIL_MODE=console

# Real destination email
MAIL_TO=khaled.yous3f19@gmail.com

# SMTP settings — required only when MAIL_MODE=smtp
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_gmail_app_password
# MAIL_FROM=your_email@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# =========================================================
# Google reCAPTCHA v3
# =========================================================
# Local default is disabled so the project runs immediately.
# In production set RECAPTCHA_ENABLED=true and add the secret key here.
# The public site key goes in public/contact.html meta[name="recaptcha-site-key"].
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=contact
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# =========================================================
# Rate limiting
# =========================================================
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=180
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
