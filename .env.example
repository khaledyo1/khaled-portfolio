# Never commit a real API key here.
# Add these values in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended after deployment.
# Use your final production URL without a trailing slash.
SITE_ORIGIN=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-project.vercel.app

# Optional CMS admin panel. Required only if you want /admin.html to save directly to GitHub.
ADMIN_PASSWORD=change-this-strong-password
GITHUB_TOKEN=github_pat_with_contents_write_permission
GITHUB_OWNER=khaledyo1
GITHUB_REPO=khaled-portfolio
GITHUB_BRANCH=main
