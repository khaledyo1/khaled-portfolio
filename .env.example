# Never commit a real API key here.
# Add these values in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Use your final production URL without a trailing slash.
SITE_ORIGIN=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-project.vercel.app

# CMS admin panel.
# Option A: simple password. Good for starting.
ADMIN_PASSWORD=change-this-strong-password

# Option B: stronger password storage. If ADMIN_PASSWORD_HASH exists, it will be used instead of ADMIN_PASSWORD.
# Generate it locally with:
# node -e "const {makePasswordHash}=require('./lib/admin-auth'); console.log(makePasswordHash('YOUR_STRONG_PASSWORD'))"
# ADMIN_PASSWORD_HASH=scrypt$your_salt$your_hash

# Recommended: independent secret used to sign admin session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-random-session-secret
ADMIN_SESSION_TTL_SECONDS=28800

# GitHub-backed CMS publishing.
GITHUB_TOKEN=github_pat_with_contents_write_permission
GITHUB_OWNER=khaledyo1
GITHUB_REPO=khaled-portfolio
GITHUB_BRANCH=main
